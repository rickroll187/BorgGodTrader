# BorgGodTrader Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# ETHEREUM / WEB3 (Required for DeFi trading)
# =============================================================================
ETH_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
ETH_PRIVATE_KEY=your_private_key_here_never_commit_this
ETH_WALLET_ADDRESS=0xYourWalletAddress

# =============================================================================
# EXCHANGE API KEYS (Fill in the ones you want to use)
# =============================================================================

# Kraken
KRAKEN_API_KEY=your_kraken_api_key
KRAKEN_API_SECRET=your_kraken_api_secret

# Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_API_SECRET=your_gemini_api_secret

# Generic CEX (for other exchanges)
CEX_API_KEY=your_cex_api_key
CEX_API_SECRET=your_cex_api_secret

# =============================================================================
# MULTI-CHAIN RPC ENDPOINTS (Optional - public fallbacks used if not set)
# Recommended: Alchemy (https://alchemy.com) or Infura (https://infura.io)
# =============================================================================
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY
BSC_RPC_URL=https://bsc-dataseed.binance.org
AVAX_RPC_URL=https://api.avax.network/ext/bc/C/rpc
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
FTM_RPC_URL=https://rpc.ftm.tools

# =============================================================================
# DATA PROVIDERS
# =============================================================================

# CoinGecko (free tier works, pro key for higher limits)
COINGECKO_API_KEY=

# Covalent (for portfolio/balance data) - https://www.covalenthq.com/
COVALENT_API_KEY=your_covalent_key

# CryptoPanic (news) - https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=your_cryptopanic_key

# Dune Analytics (on-chain analytics) - https://dune.com/
DUNE_API_KEY=your_dune_key
DUNE_QUERY_ID=your_query_id

# =============================================================================
# NOTIFICATIONS (Optional but recommended for alerts)
# =============================================================================

# Telegram Bot - https://core.telegram.org/bots
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Discord Webhook
DISCORD_WEBHOOK=https://discord.com/api/webhooks/your_webhook

# =============================================================================
# TRADING SETTINGS
# =============================================================================

# Mode: "paper" for simulation, "live" for real trading
TRADING_MODE=paper

# Maximum position size as percentage of portfolio (0.0 to 1.0)
MAX_POSITION_SIZE=0.1

# Maximum drawdown before auto-stop (0.0 to 1.0)
MAX_DRAWDOWN=0.15

# Default slippage tolerance (0.0 to 1.0)
DEFAULT_SLIPPAGE=0.005

# =============================================================================
# OPTIONAL: AI/ML Features
# =============================================================================

# OpenAI (for advanced NLP strategy parsing)
OPENAI_API_KEY=your_openai_key

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. NEVER commit this file with real values
# 2. Use a hardware wallet for large amounts
# 3. Start with paper trading mode
# 4. Set conservative position limits
# 5. Enable 2FA on all exchange accounts
